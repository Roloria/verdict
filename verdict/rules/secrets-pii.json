{
  "name": "secrets-pii",
  "version": 1,
  "description": "Credentials, keys and direct identifiers that must never reach an artifact. Catch-all regexes: expect some tuning per team.",
  "weights": {"text_absent": 0.55},
  "claims": [
    {"kind": "text_absent", "pattern": "sk-[A-Za-z0-9]{20,}", "regex": true, "note": "OpenAI key"},
    {"kind": "text_absent", "pattern": "ghp_[A-Za-z0-9]{36}", "regex": true, "note": "GitHub PAT"},
    {"kind": "text_absent", "pattern": "AKIA[0-9A-Z]{16}", "regex": true, "note": "AWS access key id"},
    {"kind": "text_absent", "pattern": "-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----", "regex": true, "note": "private key"},
    {"kind": "text_absent", "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "regex": true, "note": "JWT"},
    {"kind": "text_absent", "pattern": "xox[baprs]-[A-Za-z0-9-]{10,}", "regex": true, "note": "Slack token"},
    {"kind": "text_absent", "pattern": "[0-9]{3}-[0-9]{2}-[0-9]{4}", "regex": true, "note": "US SSN shape"},
    {"kind": "text_absent", "pattern": "[0-9]{17}[0-9Xx]", "regex": true, "note": "China resident ID shape"},
    {"kind": "text_absent", "pattern": "(?<!\\d)1[3-9][0-9]{9}(?!\\d)", "regex": true, "note": "CN mobile shape"}
  ]
}
